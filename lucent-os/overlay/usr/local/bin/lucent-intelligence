#!/usr/bin/env python3
"""Lucent Intelligence: the glass assistant built into Lucent OS.

Press Super+I to open or close it. It talks to any OpenAI-compatible chat API:
a local Ollama model by default, or a cloud model (Gemini, OpenAI, ...) after
you edit ~/.config/lucent/intelligence.json (the gear button opens it).
"""
import glob
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request

from PyQt6.QtCore import QRectF, Qt, QThread, pyqtSignal
from PyQt6.QtGui import QColor, QLinearGradient, QPainter, QPainterPath, QPen
from PyQt6.QtNetwork import QLocalServer, QLocalSocket
from PyQt6.QtWidgets import (QApplication, QHBoxLayout, QLabel, QLineEdit,
                             QPushButton, QTextBrowser, QVBoxLayout, QWidget)

APP_ID = "lucent-intelligence"
CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
                      "lucent", "intelligence.json")
DEFAULTS = {
    "base_url": "http://localhost:11434/v1",
    "model": "gemma3:4b",
    "api_key": "",
    "system": ("You are Lucent Intelligence, the assistant built into Lucent OS. "
               "Be concise, practical and friendly."),
}
WELCOME = (
    "**Hi, I’m Lucent Intelligence.**\n\n"
    "Ask me anything, or try:\n\n"
    "- “open Files” or “open Settings”\n"
    "- “dark mode” / “light mode”, “volume 40”, “lock screen”\n"
    "- Copy some text, then tap **Summarize clipboard**\n\n"
    "Press **Super+I** any time to open or close me."
)
CHIPS = [
    ("Summarize clipboard", "Summarize this in a few bullet points:\n\n{clip}"),
    ("Fix my writing", "Fix the spelling and grammar of this text, keeping my tone:\n\n{clip}"),
    ("Explain", "Explain this in simple terms:\n\n{clip}"),
]
STYLE = """
QLabel#title { color: rgba(255,255,255,235); font-size: 15px; font-weight: 600; }
QTextBrowser { background: transparent; border: none; color: rgba(255,255,255,235);
               font-size: 14px; selection-background-color: #0a84ff; }
QLineEdit { background: rgba(255,255,255,28); border: 1px solid rgba(255,255,255,70);
            border-radius: 15px; padding: 9px 14px; color: white; font-size: 14px; }
QPushButton { background: rgba(255,255,255,30); border: 1px solid rgba(255,255,255,45);
              border-radius: 12px; padding: 6px 12px; color: white; }
QPushButton:hover { background: rgba(255,255,255,60); }
QPushButton#send { background: #0a84ff; border: none; min-width: 34px; font-weight: 700; }
QPushButton#icon { padding: 4px 9px; }
"""


def load_config():
    """Read the config file, creating it with defaults on first run."""
    cfg = dict(DEFAULTS)
    try:
        with open(CONFIG, encoding="utf-8") as f:
            cfg.update(json.load(f))
    except FileNotFoundError:
        try:
            os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
            with open(CONFIG, "w", encoding="utf-8") as f:
                json.dump(DEFAULTS, f, indent=2)
        except OSError:
            pass
    except (OSError, ValueError):
        pass
    return cfg


# ---- local system actions (no model needed) -------------------------------

APP_DIRS = [
    "/usr/share/applications",
    "/usr/local/share/applications",
    os.path.expanduser("~/.local/share/applications"),
    "/var/lib/flatpak/exports/share/applications",
    os.path.expanduser("~/.local/share/flatpak/exports/share/applications"),
]


def find_app(query):
    """Return the .desktop file whose Name best matches the query."""
    q = query.strip().lower()
    partial = None
    for directory in APP_DIRS:
        for path in glob.glob(os.path.join(directory, "*.desktop")):
            try:
                with open(path, encoding="utf-8", errors="replace") as f:
                    text = f.read()
            except OSError:
                continue
            if re.search(r"^(NoDisplay|Hidden)=true", text, re.M):
                continue
            m = re.search(r"^Name=(.+)$", text, re.M)
            if not m:
                continue
            name = m.group(1).strip().lower()
            if name == q:
                return path
            if q in name and partial is None:
                partial = path
    return partial


def run(*cmd):
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        return True
    except OSError:
        return False


def local_action(text):
    """Handle simple system commands without a model. Returns a reply or None."""
    t = text.strip().lower().rstrip(".!")
    m = re.fullmatch(r"(?:open|launch|start)\s+(?:the\s+)?(.+?)(?:\s+app)?", t)
    if m:
        path = find_app(m.group(1))
        if path and run("gio", "launch", path):
            return f"Opening **{m.group(1)}**."
        return f"I couldn’t find an app called “{m.group(1)}”."
    if re.fullmatch(r"(?:turn on |switch to |enable )?dark mode|go dark", t):
        return "Switched to dark mode." if run("lucent-appearance", "dark") else "I couldn’t switch the theme."
    if re.fullmatch(r"(?:turn on |switch to |enable )?light mode|go light", t):
        return "Switched to light mode." if run("lucent-appearance", "light") else "I couldn’t switch the theme."
    if t in ("lock", "lock screen", "lock the screen", "lock my computer"):
        return "Locking the screen." if run("loginctl", "lock-session") else "I couldn’t lock the screen."
    m = re.fullmatch(r"(?:set )?volume(?: to)? (\d{1,3})\s*%?", t)
    if m:
        level = min(int(m.group(1)), 100)
        ok = run("wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{level}%")
        return f"Volume set to {level}%." if ok else "I couldn’t change the volume."
    return None


# ---- model access ---------------------------------------------------------

class ChatWorker(QThread):
    """Streams a chat completion from an OpenAI-compatible endpoint."""
    chunk = pyqtSignal(str)
    failed = pyqtSignal(str)

    def __init__(self, cfg, messages):
        super().__init__()
        self.cfg = cfg
        self.messages = messages

    def run(self):
        cfg = self.cfg
        url = cfg["base_url"].rstrip("/") + "/chat/completions"
        headers = {"Content-Type": "application/json"}
        if cfg.get("api_key"):
            headers["Authorization"] = "Bearer " + cfg["api_key"]
        body = json.dumps({"model": cfg["model"], "messages": self.messages,
                           "stream": True}).encode()
        try:
            req = urllib.request.Request(url, body, headers)
            with urllib.request.urlopen(req, timeout=120) as resp:
                for raw in resp:
                    line = raw.decode("utf-8", "replace").strip()
                    if not line.startswith("data:"):
                        continue
                    data = line[5:].strip()
                    if data == "[DONE]":
                        break
                    try:
                        delta = json.loads(data)["choices"][0]["delta"].get("content") or ""
                    except (ValueError, KeyError, IndexError):
                        continue
                    if delta:
                        self.chunk.emit(delta)
        except urllib.error.HTTPError as e:
            detail = e.read(400).decode("utf-8", "replace")
            self.failed.emit(f"The model returned an error (HTTP {e.code}).\n\n`{detail}`")
        except (urllib.error.URLError, OSError) as e:
            self.failed.emit(
                "I can’t reach the AI model. Run **Set up local AI** from the app grid, "
                f"or add a cloud API key in `{CONFIG}`.\n\n`{e}`")


# ---- window ---------------------------------------------------------------

class Window(QWidget):
    PAD = 18

    def __init__(self):
        super().__init__()
        self.cfg = load_config()
        self.history = []          # (role, text)
        self.worker = None
        self.started = False
        self.setWindowTitle("Lucent Intelligence")
        self.setWindowFlags(Qt.WindowType.FramelessWindowHint)
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
        self.setStyleSheet(STYLE)
        self.resize(580, 660)

        root = QVBoxLayout(self)
        root.setContentsMargins(self.PAD + 18, self.PAD + 12, self.PAD + 18, self.PAD + 16)
        root.setSpacing(10)

        head = QHBoxLayout()
        title = QLabel("✦  Lucent Intelligence")
        title.setObjectName("title")
        head.addWidget(title)
        head.addStretch()
        for text, slot in (("New", self.new_chat), ("⚙", self.open_config), ("✕", self.close)):
            b = QPushButton(text)
            b.setObjectName("icon")
            b.clicked.connect(slot)
            head.addWidget(b)
        root.addLayout(head)

        self.view = QTextBrowser()
        self.view.setOpenExternalLinks(True)
        root.addWidget(self.view, 1)

        chips = QHBoxLayout()
        for label, template in CHIPS:
            b = QPushButton(label)
            b.clicked.connect(lambda _=False, tpl=template: self.use_clipboard(tpl))
            chips.addWidget(b)
        chips.addStretch()
        root.addLayout(chips)

        row = QHBoxLayout()
        self.input = QLineEdit()
        self.input.setPlaceholderText("Ask anything, or say “open Files”…")
        self.input.returnPressed.connect(self.send)
        send = QPushButton("↑")
        send.setObjectName("send")
        send.clicked.connect(self.send)
        row.addWidget(self.input, 1)
        row.addWidget(send)
        root.addLayout(row)
        self.render()

    # painting: translucent glass panel with soft shadow and a specular edge
    def paintEvent(self, _event):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        panel = QRectF(self.rect().adjusted(self.PAD, self.PAD, -self.PAD, -self.PAD))
        for i in range(12):
            path = QPainterPath()
            path.addRoundedRect(panel.adjusted(-i, -i + 4, i, i + 4), 26 + i, 26 + i)
            p.fillPath(path, QColor(0, 0, 0, max(1, 9 - i)))
        body = QPainterPath()
        body.addRoundedRect(panel, 26, 26)
        fill = QLinearGradient(panel.topLeft(), panel.bottomRight())
        fill.setColorAt(0, QColor(40, 42, 66, 214))
        fill.setColorAt(1, QColor(20, 22, 38, 226))
        p.fillPath(body, fill)
        sheen = QLinearGradient(panel.topLeft(), panel.bottomLeft())
        sheen.setColorAt(0, QColor(255, 255, 255, 46))
        sheen.setColorAt(0.4, QColor(255, 255, 255, 0))
        p.fillPath(body, sheen)
        p.setPen(QPen(QColor(255, 255, 255, 72), 1.2))
        p.drawPath(body)

    def mousePressEvent(self, event):
        if event.button() == Qt.MouseButton.LeftButton and event.position().y() < self.PAD + 56:
            handle = self.windowHandle()
            if handle is not None:
                handle.startSystemMove()

    def keyPressEvent(self, event):
        if event.key() == Qt.Key.Key_Escape:
            self.close()
        else:
            super().keyPressEvent(event)

    # conversation
    def render(self):
        parts = [("**You**\n\n" if role == "user" else "**Lucent**\n\n") + text
                 for role, text in self.history]
        self.view.setMarkdown("\n\n---\n\n".join(parts) if parts else WELCOME)
        bar = self.view.verticalScrollBar()
        bar.setValue(bar.maximum())

    def new_chat(self):
        if self.worker and self.worker.isRunning():
            return
        self.history = []
        self.render()

    def open_config(self):
        load_config()
        run("xdg-open", CONFIG)

    def use_clipboard(self, template):
        clip = QApplication.clipboard().text().strip()
        if not clip:
            self.history.append(("assistant", "Your clipboard is empty. Copy some text first, then try again."))
            self.render()
            return
        self.send(template.format(clip=clip[:8000]))

    def send(self, text=None):
        if not isinstance(text, str):
            text = self.input.text()
        text = text.strip()
        if not text or (self.worker and self.worker.isRunning()):
            return
        self.input.clear()
        self.history.append(("user", text))
        reply = local_action(text)
        if reply:
            self.history.append(("assistant", reply))
            self.render()
            return
        self.cfg = load_config()
        messages = [{"role": "system", "content": self.cfg["system"]}]
        messages += [{"role": r, "content": t} for r, t in self.history]
        self.history.append(("assistant", "…"))
        self.started = False
        self.render()
        self.worker = ChatWorker(self.cfg, messages)
        self.worker.chunk.connect(self.on_chunk)
        self.worker.failed.connect(self.on_failed)
        self.worker.start()

    def on_chunk(self, piece):
        role, text = self.history[-1]
        self.history[-1] = (role, piece if not self.started else text + piece)
        self.started = True
        self.render()

    def on_failed(self, message):
        self.history[-1] = ("assistant", message)
        self.started = True
        self.render()


def main():
    app = QApplication(sys.argv)
    app.setApplicationName(APP_ID)
    app.setDesktopFileName(APP_ID)

    # Super+I runs this program again: if a window is already open, tell it to close.
    name = f"{APP_ID}-{os.getuid()}"
    sock = QLocalSocket()
    sock.connectToServer(name)
    if sock.waitForConnected(250):
        sock.write(b"quit")
        sock.flush()
        sock.waitForBytesWritten(500)
        sock.disconnectFromServer()
        return 0

    QLocalServer.removeServer(name)
    server = QLocalServer()
    server.listen(name)
    win = Window()

    def on_connection():
        conn = server.nextPendingConnection()
        if conn is not None:
            conn.readyRead.connect(win.close)

    server.newConnection.connect(on_connection)
    win.show()
    win.input.setFocus()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
